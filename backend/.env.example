# Groq API Key (free tier available at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model (e.g., openai/gpt-oss-120b, llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# Server Port
PORT=8000
HOST=0.0.0.0

# Optional: Tavily API key for high-grade web search (DuckDuckGo is used by default for free)
# TAVILY_API_KEY=tvly-your_key_here
